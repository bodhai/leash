# All optional — Leash runs in offline/simulated mode without any of them.

# ---- AI: Claude (https://console.anthropic.com) — enables the AI agent + policy compiler
ANTHROPIC_API_KEY=
# LEASH_MODEL=claude-opus-5-5

# ---- PayPal sandbox app (https://developer.paypal.com → Apps & Credentials → Sandbox)
# Enable "Save payment methods" (Vault) on the app for autonomous mandate payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# Webhook ID from the same app (Webhooks section) — enables /api/paypal/webhook signature checks.
# PAYPAL_WEBHOOK_ID=

# ---- Network
# 0.0.0.0 = reachable from every device on your LAN (phone wallet). Use 127.0.0.1 for this PC only.
HOST=0.0.0.0
PORT=3000
# Require a PIN for every API call from the LAN (recommended on shared Wi-Fi).
# LEASH_PIN=

# ---- Storage
# State is saved to data/state.json. Set to 0 to keep everything in memory only.
# LEASH_PERSIST=1
